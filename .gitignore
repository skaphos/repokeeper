dist/

# IDE
.idea/
.vscode/
*.swp
*.swo
.codex
# Ignore everything Claude Code writes into .claude (worktrees, local settings,
# transcripts) EXCEPT the spec-kit skills. The Codex integration installs its
# copies into the tracked .agents/skills/, so they survive a clone; the Claude
# integration targets .claude/skills/, which a blanket `.claude` ignore silently
# dropped -- leaving `specify integration status` reporting 10 missing managed
# files on every fresh checkout. Negation needs `.claude/*` rather than
# `.claude`, because git will not descend into an excluded directory to
# re-include a child.
.claude/*
!.claude/skills/
.cursor/
.windsurf/
.continue/
.cody/
.roo/
.roo-code/
.aider*
CLAUDE.md

# OS
.DS_Store
Thumbs.db

# Local junk
.gocache
.cache/
perf/runs/
.sisyphus/

# Graphify — the canonical code graph, its report, and community labels are
# committed and shared. Everything else under graphify-out/ is local build
# state (extraction cache, incremental manifest, the regenerable HTML viz, and
# dated snapshots) and stays out of git.
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/.graphify_labels.json
# Local, machine-specific interpreter marker.
/.graphify_*

# Go build/test output
*.out
vendor/
